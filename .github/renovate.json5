{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "github>Turbo87/renovate-config//rust/updateToolchain"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Keep the plugin's pinned support-bundle binary, the Job image's pinned binary, and the chart's declared troubleshoot_version in lock-step — all three match strings share a depName, so Renovate bumps them together in one PR.",
      "fileMatch": [
        "^router-diagnostics-helm-plugin/scripts/install-binary\\.sh$",
        "^router-diagnostics-job-image/Dockerfile$",
        "^router-diagnostics/templates/base-spec-configmap\\.yaml$",
      ],
      "matchStrings": [
        "SUPPORT_BUNDLE_VERSION=\"(?<currentValue>.*?)\"",
        "\"troubleshoot_version\": \"(?<currentValue>.*?)\"",
      ],
      "depNameTemplate": "replicatedhq/troubleshoot",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$",
    },
  ],
}
