{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'github>Turbo87/renovate-config//rust/updateToolchain',
  ],
  customManagers: [
    {
      customType: 'regex',
      description: "The Job image's pinned aws-cli/curl/ca-certificates apk versions are supplied through an ARG, which Renovate's built-in apk datasource can't see (it only detects a version written directly on the apk add line). Repology mirrors Alpine's own per-branch package versions, so each '# renovate:' comment names the alpine_3_22/<pkg> project directly; versioning=loose is needed to sort the apk '-rN' revision suffix correctly.",
      managerFilePatterns: [
        '/^router-diagnostics-job-image/Dockerfile$/',
      ],
      matchStrings: [
        '# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?\\s*\\n\\s*ARG \\w+="(?<currentValue>[^"]+)"',
      ],
    },
    {
      customType: 'regex',
      description: "Keep the collect scripts' pinned support-bundle binary, the Job image's pinned binary, and the chart's declared troubleshoot_version in lock-step — all four match strings share a depName, so Renovate bumps them together in one PR.",
      managerFilePatterns: [
        '/^router-diagnostics-collect/collect\\.sh$/',
        '/^router-diagnostics-collect/collect\\.ps1$/',
        '/^router-diagnostics-job-image/Dockerfile$/',
        '/^router-diagnostics-chart/templates/base-spec-configmap\\.yaml$/',
      ],
      matchStrings: [
        'SUPPORT_BUNDLE_VERSION="(?<currentValue>.*?)"',
        '"troubleshoot_version": "(?<currentValue>.*?)"',
      ],
      depNameTemplate: 'replicatedhq/troubleshoot',
      datasourceTemplate: 'github-releases',
      extractVersionTemplate: '^v(?<version>.*)$',
    },
    {
      customType: 'regex',
      description: "static-checks.yaml's helm_lint/spec_lint jobs and collect-integration-test.yaml's official-chart Helm-version job each pin the same two explicit Helm versions (one v3, one v4) to test both major versions we support, independent of mise.toml's single helm pin. All four match strings share a depName/packageName (the same upstream repo), so the packageRules below are what keeps each one bumping within its own major version rather than Renovate proposing a v3 entry jump straight to a v4 release or vice versa.",
      managerFilePatterns: [
        '/^\\.github/workflows/static-checks\\.yaml$/',
        '/^\\.github/workflows/collect-integration-test\\.yaml$/',
      ],
      matchStrings: [
        'helm_version: \\["(?<currentValue>3\\.[^"]+)",',
        'helm_version: \\["[^"]+",\\s*"(?<currentValue>4\\.[^"]+)"\\]',
      ],
      depNameTemplate: 'helm/helm',
      packageNameTemplate: 'helm/helm',
      datasourceTemplate: 'github-releases',
      extractVersionTemplate: '^v(?<version>.*)$',
    },
  ],
  packageRules: [
    {
      description: "Keep each file's explicit helm_version matrix entries each pinned within their own major version.",
      matchFileNames: ['.github/workflows/static-checks.yaml', '.github/workflows/collect-integration-test.yaml'],
      matchCurrentValue: '/^3\\./',
      allowedVersions: '<4.0.0',
    },
    {
      matchFileNames: ['.github/workflows/static-checks.yaml', '.github/workflows/collect-integration-test.yaml'],
      matchCurrentValue: '/^4\\./',
      allowedVersions: '>=4.0.0 <5.0.0',
    },
  ],
}
