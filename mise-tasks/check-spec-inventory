#!/usr/bin/env bash
#MISE description="Diff the rendered spec's collector+redactor inventory (names/types/count) against the checked-in baseline"
#
# Not a naming-convention check - specs/collection/collector_naming.md governs collector
# names specifically, and has nothing to say about redactors. This catches a broader class
# of silent drift: any collector or redactor renamed, added, or removed without the baseline
# being updated (and, for a collector's name, without collector_naming.md's table being
# checked - that's still the reader's job, this only flags that something changed).
# A disappeared redactor is the sharper risk here: unlike a collector rename, it's a
# potential data leak, not just a broken bundle path.
set -euo pipefail

CHART_PATH="router-diagnostics"
BASELINE="testing/spec-inventory-baseline.json"

RENDERED=$(helm template ci-test "$CHART_PATH" --set namespace=ci-test --set mode=local \
  --show-only templates/base-spec-configmap.yaml)

extract() {
  # $1: the data key holding an embedded YAML doc (support-bundle-spec or redactor-spec).
  # $2: jq filter producing the list of {type, name} entries from that doc's JSON form.
  local key="$1" filter="$2"
  local doc
  doc=$(echo "$RENDERED" | yq ".data[\"$key\"]" 2>/dev/null || true)
  [ -z "$doc" ] || [ "$doc" = "null" ] && return
  echo "$doc" | yq -o=json | jq -c "$filter"
}

COLLECTORS=$(extract "support-bundle-spec" \
  '[.spec.collectors[] | to_entries[0] as $e | {kind: "collector", type: $e.key, name: ($e.value.name // $e.value.collectorName)}]')

REDACTORS=$(extract "redactor-spec" \
  '[.spec.redactors[] | {kind: "redactor", type: "redactor", name: .name}]')

ACTUAL=$(jq -cs '(.[0] // []) + (.[1] // []) | sort_by(.kind, .type, .name)' \
  <(echo "${COLLECTORS:-[]}") <(echo "${REDACTORS:-[]}"))

if [ "${UPDATE_BASELINE:-}" = "1" ]; then
  jq '.' <<<"$ACTUAL" > "$BASELINE"
  echo "Wrote $BASELINE"
  exit 0
fi

if [ ! -f "$BASELINE" ]; then
  echo "No baseline found at $BASELINE - run with UPDATE_BASELINE=1 to create it." >&2
  exit 1
fi

EXPECTED=$(jq -c 'sort_by(.kind, .type, .name)' "$BASELINE")

if [ "$ACTUAL" != "$EXPECTED" ]; then
  echo "Collector/redactor inventory in the rendered spec doesn't match $BASELINE." >&2
  echo "Something was renamed, added, or removed. If intentional, update the baseline:" >&2
  echo "  UPDATE_BASELINE=1 mise run check-spec-inventory" >&2
  echo "and, for a collector rename, check it against specs/collection/collector_naming.md in the same PR." >&2
  echo >&2
  echo "--- expected ($BASELINE) ---" >&2
  jq '.' <<<"$EXPECTED" >&2
  echo "--- actual (rendered spec) ---" >&2
  jq '.' <<<"$ACTUAL" >&2
  exit 1
fi

echo "Collector/redactor inventory matches $BASELINE"
