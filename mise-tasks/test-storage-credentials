#!/usr/bin/env bash
#MISE description="Assert job.storage credential wiring (existingSecret, static values, IRSA/Workload Identity) renders correctly"
set -euo pipefail

CHART_PATH="router-diagnostics-chart"
WORKDIR=$(mktemp -d)
trap 'rm -rf "$WORKDIR"' EXIT

query_service_account() {
  yq "select(.kind == \"ServiceAccount\") | $1" "$WORKDIR/rendered.yaml"
}

query_job_pod_spec() {
  yq "select(.kind == \"Job\") | .spec.template.spec | $1" "$WORKDIR/rendered.yaml"
}

assert_eq() {
  description="$1"
  query="$2"
  expected="$3"
  actual=$(query_job_pod_spec "$query")
  if [ "$actual" != "$expected" ]; then
    echo "FAIL: expected $description" >&2
    echo "  query: $query" >&2
    echo "  expected: $expected" >&2
    echo "  actual:   $actual" >&2
    exit 1
  fi
}

assert_command_contains() {
  value="$1"
  if [ "$(query_job_pod_spec ".containers[0].command | contains([\"$value\"])")" != "true" ]; then
    echo "FAIL: expected \"$value\" among the args collect-and-upload.sh receives" >&2
    exit 1
  fi
}

# Confirms the annotations reach the ServiceAccount unchanged.
# (this is the only part of IRSA/Workload Identity the chart controls)
echo "Test: job.serviceAccount.annotations (IRSA / Workload Identity)"
helm template ci-test "$CHART_PATH" \
  --set namespace=ci-test \
  --set mode=job \
  --set job.image.repository=ci-placeholder \
  --set job.image.tag=v0.0.0 \
  --set job.storage.provider=s3 \
  --set-string 'job.serviceAccount.annotations.eks\.amazonaws\.com/role-arn=arn:aws:iam::123456789012:role/test-role' \
  --set-string 'job.serviceAccount.annotations.iam\.gke\.io/gcp-service-account=test@test-project.iam.gserviceaccount.com' \
  > "$WORKDIR/rendered.yaml"

ROLE_ARN_ANNOTATION=$(query_service_account '.metadata.annotations["eks.amazonaws.com/role-arn"]')
if [ "$ROLE_ARN_ANNOTATION" != "arn:aws:iam::123456789012:role/test-role" ]; then
  echo "FAIL: expected eks.amazonaws.com/role-arn annotation on the Job ServiceAccount" >&2
  echo "  actual: $ROLE_ARN_ANNOTATION" >&2
  exit 1
fi
GCP_SA_ANNOTATION=$(query_service_account '.metadata.annotations["iam.gke.io/gcp-service-account"]')
if [ "$GCP_SA_ANNOTATION" != "test@test-project.iam.gserviceaccount.com" ]; then
  echo "FAIL: expected iam.gke.io/gcp-service-account annotation on the Job ServiceAccount" >&2
  echo "  actual: $GCP_SA_ANNOTATION" >&2
  exit 1
fi
echo

# Confirms the Job pulls env from the given Secret and collect-and-upload.sh gets the right
# bucket/prefix/region/endpoint/forcePathStyle args.
echo "Test: job.storage.provider=s3, existingSecret"
helm template ci-test "$CHART_PATH" \
  --set namespace=ci-test \
  --set mode=job \
  --set job.image.repository=ci-placeholder \
  --set job.image.tag=v0.0.0 \
  --set job.storage.provider=s3 \
  --set job.storage.bucket=my-test-bucket \
  --set job.storage.prefix=my-test-prefix/ \
  --set job.storage.s3.region=us-west-2 \
  --set job.storage.s3.endpoint=https://minio.example.com:9000 \
  --set job.storage.s3.forcePathStyle=true \
  --set job.storage.existingSecret=my-s3-secret \
  > "$WORKDIR/rendered.yaml"
assert_eq "the Job container to pull env from the given existingSecret" \
  ".containers[0].envFrom[0].secretRef.name" "my-s3-secret"
assert_command_contains "my-test-bucket"
assert_command_contains "my-test-prefix/"
assert_command_contains "us-west-2"
assert_command_contains "https://minio.example.com:9000"
assert_command_contains "true"
echo

# Confirms the chart's own Secret carries the given keys and the Job pulls from it
echo "Test: job.storage.provider=s3, static accessKeyId/secretAccessKey (no existingSecret)"
helm template ci-test "$CHART_PATH" \
  --set namespace=ci-test \
  --set mode=job \
  --set job.image.repository=ci-placeholder \
  --set job.image.tag=v0.0.0 \
  --set job.storage.provider=s3 \
  --set job.storage.bucket=my-test-bucket \
  --set job.storage.s3.accessKeyId=my-test-access-key \
  --set job.storage.s3.secretAccessKey=my-test-secret-key \
  > "$WORKDIR/rendered.yaml"
# No existingSecret this time, so the chart must render its own Secret with these values baked in.
SECRET_YAML=$(yq 'select(.kind == "Secret")' "$WORKDIR/rendered.yaml")
if [ "$(yq '.stringData.AWS_ACCESS_KEY_ID' <<< "$SECRET_YAML")" != "my-test-access-key" ]; then
  echo "FAIL: expected the chart-rendered Secret to carry the static access key" >&2
  exit 1
fi
if [ "$(yq '.stringData.AWS_SECRET_ACCESS_KEY' <<< "$SECRET_YAML")" != "my-test-secret-key" ]; then
  echo "FAIL: expected the chart-rendered Secret to carry the static secret key" >&2
  exit 1
fi
assert_eq "the Job container to pull env from the chart-rendered Secret" \
  ".containers[0].envFrom[0].secretRef.name" "router-diagnostics-storage-credentials"
echo

# Same as the s3 existingSecret test above, but GCS mounts credentials as a key file volume
# instead of env vars.
echo "Test: job.storage.provider=gcs, existingSecret"
helm template ci-test "$CHART_PATH" \
  --set namespace=ci-test \
  --set mode=job \
  --set job.image.repository=ci-placeholder \
  --set job.image.tag=v0.0.0 \
  --set job.storage.provider=gcs \
  --set job.storage.bucket=my-test-bucket \
  --set job.storage.prefix=my-test-prefix/ \
  --set job.storage.gcs.project=my-test-project \
  --set job.storage.existingSecret=my-gcs-secret \
  > "$WORKDIR/rendered.yaml"
assert_eq "GOOGLE_APPLICATION_CREDENTIALS to point at the mounted key" \
  '.containers[0].env[] | select(.name == "GOOGLE_APPLICATION_CREDENTIALS") | .value' \
  "/var/run/secrets/router-diagnostics-storage/key.json"
assert_eq "the credentials volume to mount the given existingSecret" \
  '.volumes[] | select(.name == "storage-credentials") | .secret.secretName' "my-gcs-secret"
assert_command_contains "my-test-bucket"
assert_command_contains "my-test-prefix/"
assert_command_contains "my-test-project"
echo

echo "Test: job.storage.existingSecret + a static credential must be rejected"
if helm template ci-test "$CHART_PATH" \
  --set namespace=ci-test \
  --set mode=job \
  --set job.image.repository=ci-placeholder \
  --set job.image.tag=v0.0.0 \
  --set job.storage.provider=s3 \
  --set job.storage.bucket=my-test-bucket \
  --set job.storage.existingSecret=my-s3-secret \
  --set job.storage.s3.accessKeyId=my-test-access-key \
  --set job.storage.s3.secretAccessKey=my-test-secret-key \
  > "$WORKDIR/rendered.yaml" 2>"$WORKDIR/stderr.log"; then
  echo "FAIL: expected helm template to reject existingSecret + a static s3 credential together" >&2
  exit 1
fi
if ! grep -q 'mutually exclusive' "$WORKDIR/stderr.log"; then
  echo "FAIL: expected the mutually-exclusive error, got:" >&2
  cat "$WORKDIR/stderr.log" >&2
  exit 1
fi
echo

# GCS equivalent of the s3 static-values test above.
echo "Test: job.storage.provider=gcs, static credentialsJson (no existingSecret)"
helm template ci-test "$CHART_PATH" \
  --set namespace=ci-test \
  --set mode=job \
  --set job.image.repository=ci-placeholder \
  --set job.image.tag=v0.0.0 \
  --set job.storage.provider=gcs \
  --set job.storage.bucket=my-test-bucket \
  --set job.storage.gcs.credentialsJson=my-test-service-account-json \
  > "$WORKDIR/rendered.yaml"
if [ "$(yq 'select(.kind == "Secret") | .stringData."key.json"' "$WORKDIR/rendered.yaml")" != 'my-test-service-account-json' ]; then
  echo "FAIL: expected the chart-rendered Secret to carry the static credentials JSON" >&2
  exit 1
fi
assert_eq "the credentials volume to mount the chart-rendered Secret" \
  '.volumes[] | select(.name == "storage-credentials") | .secret.secretName' "router-diagnostics-storage-credentials"
echo
