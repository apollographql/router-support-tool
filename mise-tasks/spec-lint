#!/usr/bin/env bash
#MISE description="Run support-bundle lint against the rendered spec, for the declared floor and current troubleshoot.sh releases"
set -euo pipefail

CHART_PATH="router-diagnostics"
WORKDIR=$(mktemp -d)
trap 'rm -rf "$WORKDIR"' EXIT

case "$(uname -s)" in
  Darwin) ASSET="support-bundle_darwin_all.tar.gz" ;;
  Linux)
    case "$(uname -m)" in
      arm64|aarch64) ASSET="support-bundle_linux_arm64.tar.gz" ;;
      *) ASSET="support-bundle_linux_amd64.tar.gz" ;;
    esac
    ;;
  *) echo "Unsupported OS: $(uname -s)" >&2; exit 1 ;;
esac

FLOOR=$(helm template ci-test "$CHART_PATH" --set namespace=ci-test --set mode=local \
  --show-only templates/base-spec-configmap.yaml \
  | yq '.data["support-bundle-spec"]' \
  | yq '.spec.collectors[] | select(has("data")) | .data.data' \
  | jq -r '.min_troubleshoot_version')

CURRENT=$(curl -sL https://api.github.com/repos/replicatedhq/troubleshoot/releases/latest | jq -r '.tag_name | ltrimstr("v")')

echo "Declared floor: $FLOOR"
echo "Current release: $CURRENT"

helm template ci-test "$CHART_PATH" --set namespace=ci-test --set mode=local \
  --show-only templates/base-spec-configmap.yaml \
  | yq '.data["support-bundle-spec"]' > "$WORKDIR/rendered-spec.local.yaml"

helm template ci-test "$CHART_PATH" --set namespace=ci-test --set mode=job \
  --set job.image.repository=ci-placeholder --set job.image.tag=v0.0.0 \
  --show-only templates/base-spec-configmap.yaml \
  | yq '.data["support-bundle-spec"]' > "$WORKDIR/rendered-spec.job.yaml"

for VERSION in $(printf '%s\n%s\n' "$FLOOR" "$CURRENT" | sort -u); do
  echo "==> support-bundle $VERSION"
  curl -sL "https://github.com/replicatedhq/troubleshoot/releases/download/v${VERSION}/${ASSET}" \
    | tar xz -C "$WORKDIR" support-bundle
  "$WORKDIR/support-bundle" lint --format json "$WORKDIR/rendered-spec.local.yaml" "$WORKDIR/rendered-spec.job.yaml"
  echo
done
