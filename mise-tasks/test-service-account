#!/usr/bin/env bash
#MISE description="Assert job.serviceAccount.name renders no chart RBAC and runs the Job as the named ServiceAccount"
set -euo pipefail

CHART_PATH="router-diagnostics-chart"
WORKDIR=$(mktemp -d)
trap 'rm -rf "$WORKDIR"' EXIT

JOB_ARGS=(
  --set namespace=ci-test
  --set mode=job
  --set job.image.repository=ci-placeholder
  --set job.image.tag=v0.0.0
  --set job.storage.provider=s3
)

fail() {
  echo "FAIL: $1" >&2
  exit 1
}

count_kind() {
  yq "select(.kind == \"$1\") | .kind" "$WORKDIR/rendered.yaml" | grep -c . || true
}

assert_kind_count() {
  kind="$1"
  expected="$2"
  actual=$(count_kind "$kind")
  [ "$actual" = "$expected" ] || fail "expected $expected $kind object(s), got $actual"
}

assert_job_service_account() {
  expected="$1"
  actual=$(yq 'select(.kind == "Job") | .spec.template.spec.serviceAccountName' "$WORKDIR/rendered.yaml")
  [ "$actual" = "$expected" ] || fail "expected the Job to run as $expected, got $actual"
}

echo "Test: default install keeps the chart-created ServiceAccount and RBAC"
helm template ci-test "$CHART_PATH" "${JOB_ARGS[@]}" > "$WORKDIR/rendered.yaml"
for kind in ServiceAccount Role RoleBinding ClusterRole ClusterRoleBinding; do
  assert_kind_count "$kind" 1
done
assert_job_service_account router-diagnostics-job
echo

echo "Test: job.serviceAccount.name renders no ServiceAccount or RBAC and the Job uses the name"
helm template ci-test "$CHART_PATH" "${JOB_ARGS[@]}" --set job.serviceAccount.name=my-sa > "$WORKDIR/rendered.yaml"
for kind in ServiceAccount Role RoleBinding ClusterRole ClusterRoleBinding; do
  assert_kind_count "$kind" 0
done
assert_kind_count Job 1
assert_job_service_account my-sa
echo

echo "Test: job.serviceAccount.name + job.collectNodeMetrics=false"
helm template ci-test "$CHART_PATH" "${JOB_ARGS[@]}" \
  --set job.serviceAccount.name=my-sa \
  --set job.collectNodeMetrics=false > "$WORKDIR/rendered.yaml"
for kind in ServiceAccount Role RoleBinding ClusterRole ClusterRoleBinding; do
  assert_kind_count "$kind" 0
done
assert_job_service_account my-sa
echo

echo "Test: job.serviceAccount.name + job.serviceAccount.annotations must be rejected"
if helm template ci-test "$CHART_PATH" "${JOB_ARGS[@]}" \
  --set job.serviceAccount.name=my-sa \
  --set-string 'job.serviceAccount.annotations.eks\.amazonaws\.com/role-arn=arn:aws:iam::123456789012:role/test-role' \
  > "$WORKDIR/rendered.yaml" 2>"$WORKDIR/stderr.log"; then
  fail "expected helm template to reject job.serviceAccount.name + annotations together"
fi
if ! grep -q 'cannot be set together' "$WORKDIR/stderr.log"; then
  echo "FAIL: expected the 'cannot be set together' error, got:" >&2
  cat "$WORKDIR/stderr.log" >&2
  exit 1
fi
echo "OK"
